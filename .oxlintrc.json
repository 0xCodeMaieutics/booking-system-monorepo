{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "nextjs", "jsx-a11y", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "oxc/no-map-spread": "off",
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css", "server-only"] }],
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error"
  },
  "overrides": [
    {
      "files": ["apps/admin/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@tanstack/react-query",
                "importNames": [
                  "useQuery",
                  "useQueries",
                  "useSuspenseQuery",
                  "useSuspenseQueries",
                  "useInfiniteQuery",
                  "useSuspenseInfiniteQuery"
                ],
                "message": "Fetch data in a server component with serverCaller() and pass it down as props; refresh after mutations with useRefreshingMutation (docs/adr/0007)."
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": [
    "apps/landing/**",
    "packages/db/migrations/**",
    "packages/ui/src/components/**",
    "**/.next/**",
    "**/next-env.d.ts"
  ]
}
