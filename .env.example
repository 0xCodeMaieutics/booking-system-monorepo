# Local development: one file shared by both apps and packages/db.
# For what each deployed app needs, see apps/admin/.env.example and apps/booking/.env.example.

# Matches docker-compose.yml.
DATABASE_URL=postgres://postgres@localhost:5433/tsami

# Practitioner Photos (ADR 0006). Defaults below match the SeaweedFS service in
# docker-compose.yml; production uses a Cloudflare R2 bucket with public reads.
# Both apps need PHOTOS_URL; only the Admin Dashboard needs the S3 credentials.
PHOTOS_URL=http://localhost:8333/tsami-photos
PHOTOS_S3_ENDPOINT=http://localhost:8333
# R2 expects "auto".
PHOTOS_S3_REGION=us-east-1
PHOTOS_S3_BUCKET=tsami-photos
PHOTOS_S3_ACCESS_KEY_ID=tsami
PHOTOS_S3_SECRET_ACCESS_KEY=tsami-dev-secret

# Both apps send SMS. Leave empty in development to log SMS to the console.
# Production uses SMS_PROVIDER=sender.ge with SENDER_GE_API_KEY.
SMS_PROVIDER=
SENDER_GE_API_KEY=

# Failed SMS alerts go to this Telegram chat. Leave empty to only log them.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Admin Dashboard (apps/admin)
BETTER_AUTH_SECRET=replace-with-32-random-bytes
BETTER_AUTH_URL=http://localhost:3002
ADMIN_EMAIL_FROM="Tsami <no-reply@tsami.ge>"
# Leave empty in development to log emails to the console.
RESEND_API_KEY=

# Booking Site (apps/booking)
BOOKING_BASE_URL=http://localhost:3000
# Protects /api/cron/reminders; Vercel Cron sends it as a Bearer token.
CRON_SECRET=replace-me
