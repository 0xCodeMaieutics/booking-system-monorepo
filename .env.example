# Shared by both apps and packages/db.
DATABASE_URL=postgres://localhost:5432/face

# Admin Dashboard (apps/admin)
BETTER_AUTH_SECRET=replace-with-32-random-bytes
BETTER_AUTH_URL=http://localhost:3001
ADMIN_EMAIL_FROM="Tsami <no-reply@example.com>"
# Leave empty in development to log emails to the console.
RESEND_API_KEY=

# Booking Site (apps/booking)
BOOKING_SITE_URL=http://localhost:3000
# Protects /api/cron/reminders; Vercel Cron sends it as a Bearer token.
CRON_SECRET=replace-me
# Leave empty in development to log SMS to the console.
SMS_PROVIDER=
