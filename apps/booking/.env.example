# Environment variables the Booking Site reads when deployed.
# Local development uses the shared .env at the repo root instead.

DATABASE_URL=postgres://user:password@host:5432/tsami

# This app's own public URL, used in links sent by SMS.
BOOKING_BASE_URL=https://book.example.com

# Verification codes, confirmations and reminders. Required in production.
SMS_PROVIDER=sender.ge
SENDER_GE_API_KEY=

# Failed SMS alerts go to this Telegram chat. Optional; without them failures are only logged.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Protects /api/cron/reminders; Vercel Cron sends it as a Bearer token.
CRON_SECRET=replace-me

# Practitioner Photos (ADR 0006). Read-only: public base URL that browsers load photos from
# (R2 custom domain or r2.dev), without the bucket name. No S3 credentials needed.
PHOTOS_URL=https://photos.example.com
