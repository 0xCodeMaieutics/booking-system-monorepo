# Environment variables the Admin Dashboard reads when deployed.
# Local development uses the shared .env at the repo root instead.

DATABASE_URL=postgres://user:password@host:5432/tsami

# Better Auth. BETTER_AUTH_URL is this app's own public URL.
BETTER_AUTH_SECRET=replace-with-32-random-bytes
BETTER_AUTH_URL=https://admin.example.com

# Password-set emails for Admin invitations and resets. RESEND_API_KEY is required in production.
RESEND_API_KEY=
ADMIN_EMAIL_FROM="Tsami <no-reply@example.com>"

# Patient SMS on cancellations and moves. Required in production.
SMS_PROVIDER=

# Public URL of the Booking Site, used to build Clinic booking links.
BOOKING_SITE_URL=https://book.example.com

# Practitioner Photos (ADR 0006). The Admin Dashboard is the only app that writes to the bucket.
# Public base URL that browsers load photos from (R2 custom domain or r2.dev), without the bucket name.
PHOTOS_URL=https://photos.example.com
# R2 S3 API endpoint without the bucket name; EU-jurisdiction buckets use <account>.eu.r2.cloudflarestorage.com.
PHOTOS_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
PHOTOS_S3_REGION=auto
PHOTOS_S3_BUCKET=tsami-practitioner-photos-prod
# R2 API token with Object Read & Write on the bucket.
PHOTOS_S3_ACCESS_KEY_ID=
PHOTOS_S3_SECRET_ACCESS_KEY=
