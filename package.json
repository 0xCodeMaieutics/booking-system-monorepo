{
  "name": "tsami",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:landing": "pnpm --filter @tsami/face-landing dev",
    "dev:admin": "pnpm --filter @tsami/admin dev",
    "dev:booking": "pnpm --filter @tsami/booking-site dev",
    "dev:marketing": "pnpm --filter @tsami/marketing dev",
    "build": "pnpm --filter @tsami/admin --filter @tsami/booking-site --filter @tsami/marketing build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @tsami/db generate",
    "db:migrate": "pnpm --filter @tsami/db migrate",
    "db:seed": "pnpm --filter @tsami/db seed",
    "db:reset": "pnpm --filter @tsami/db reset",
    "admin:create": "pnpm --filter @tsami/admin admin:create",
    "admin:create-dev": "pnpm --filter @tsami/admin admin:create-dev"
  },
  "devDependencies": {
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@9.4.0"
}
