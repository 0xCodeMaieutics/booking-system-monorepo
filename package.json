{
  "name": "face-aesthetic-centre",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:landing": "pnpm --filter @face/landing dev",
    "dev:admin": "pnpm --filter @face/admin dev",
    "dev:booking": "pnpm --filter @face/booking-site dev",
    "build": "pnpm --filter @face/admin --filter @face/booking-site build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @face/db generate",
    "db:migrate": "pnpm --filter @face/db migrate",
    "db:seed": "pnpm --filter @face/db seed",
    "admin:create": "pnpm --filter @face/admin admin:create"
  },
  "devDependencies": {
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@9.4.0"
}
